{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"semi": true,
	"useTabs": true,
	"tabWidth": 2,
	"singleQuote": false,
	"printWidth": 100,
	"trailingComma": "none",
	"endOfLine": "lf",
	"sortPackageJson": false,
	"ignorePatterns": [
		"dist/*",
		"html/*",
		".local",
		"node_modules/**",
		"**/*.svg",
		"**/*.sh",
		"public/*"
	]
}
