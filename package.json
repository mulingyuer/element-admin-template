		"typescript": "~5.7.3",
		"unplugin-auto-import": "^19.0.0",
		"unplugin-vue-components": "^28.0.0",
		"vite": "^6.0.7",
		"vite-bundle-analyzer": "^0.16.0",
		"vite-plugin-style-import": "^2.0.0",
