		"element-plus": "^2.9.3",
		"nprogress": "^0.2.0",
		"pinia": "^2.3.0",
		"pinia-plugin-persistedstate": "^4.2.0",
		"sass": "^1.83.4",
		"vue": "^3.5.13",
		"vue-router": "^4.5.0"
	},
	"devDependencies": {
		"@iconify-json/ep": "^1.2.2",
